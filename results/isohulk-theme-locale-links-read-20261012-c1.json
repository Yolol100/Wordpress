agen' => 'Frequently asked questions',\n );\n return isset($labels[$slug]) ? $labels[$slug] : $fallback;\n}\n\nadd_action('after_setup_theme', function() {\n add_theme_support('title-tag');\n add_theme_support('post-thumbnails');\n add_theme_support('responsive-embeds');\n add_theme_support('automatic-feed-links');\n add_theme_support('woocommerce');\n register_nav_menus(array('primary' => __('Primary navigation', 'tps-pack')));\n add_theme_support('html5', array('search-form','gallery','caption','comment-form','comment-list'));\n});\nadd_action('wp_enqueue_scripts', function() {\n wp_enqueue_style('tps-pack-font', 'https:\/\/fonts.googleapis.com\/css2?family=Manrope:wght@400;500;600;700;800&display=swap', array(), null);\n wp_enqueue_style('tps-pack-style', get_theme_file_uri('\/assets\/site.css'), array('tps-pack-font'), '2.3.0');\n if (is_home() || is_category() || is_tag() || is_author() || is_date() || is_singular('post')) {\n  wp_enqueue_style('tps-pack-blog', get_theme_file_uri('\/assets\/blog.css'), array('tps-pack-style'), '2.3.0');\n }\n if (is_front_page()) {\n  wp_enqueue_style('tps-pack-home', get_theme_file_uri('\/assets\/home.css'), array('tps-pack-style'), '2.3.0');\n  wp_enqueue_script('tps-pack-home-script', get_theme_file_uri('\/assets\/home.js'), array(), '2.0.0', true);\n } else {\n  wp_enqueue_script('tps-pack-script', get_theme_file_uri('\/assets\/site.js'), array(), '2.0.0', true);\n }\n});\n\nadd_filter('body_class', function($classes) { if (is_front_page()) { $classes[] = 'design-2'; $classes[] = 'refined'; } return $classes; });\n\n\n\n\/**\n * Theme-owned contact and catalogue services, intentionally bound to this theme.\n * Legacy TPS Pack Catalogue Core loads earlier than the active theme. During a\n * 1.6.0 -> 1.7.0 migration, do not redeclare any of its public functions or\n * register a second handler. Once that old plugin is deactivated, these\n * services load automatically on the next request from the theme alone.\n *\/\nif (!function_exists('tps_pack_handle_enquiry')) {\n require_once get_parent_theme_file_path('inc\/catalog.php');\n require_once get_parent_theme_file_path('inc\/forms.php');\n} else {\n add_action('admin_notices', function () {\n  if (!current_user_can('manage_options')) return;\n  echo '<div class=\"notice notice-warning\"><p>'\n   . esc_html__('TPS Pack 2.3.0 includes enquiry forms and catalogue mode. Deactivate the old TPS Pack Catalogue Core plugin after updating the theme; it is no longer required.', 'tps-pack')\n   . '<\/p><\/div>';\n });\n}\n","fingerprint":"255db2a6c459a407ebede25db1c74553c73acbeb99b38163ea48002e1523c7da"}},{"action":"filesystem.read_text","result":{"file":{"path":"wp-content\/themes\/tps-pack-wordpress-theme\/header.php","bytes":6057,"sha256":"1ee9b2792f168f7b4643560290fcde2c68f660ef7d6d87b2b811b5e9aa56acb2","modified_gmt":"2026-10-12T09:07:08+00:00","writable_text_scope":true},"content":"<?php if ( ! defined('ABSPATH') ) exit; ?>\n<!doctype html><html <?php language_attributes(); ?>><head><meta charset=\"<?php bloginfo('charset'); ?>\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"color-scheme\" content=\"light\"><?php wp_head(); ?><\/head><body <?php body_class(); ?> id=\"page-top\"><?php wp_body_open(); ?><a class=\"skip\" href=\"#main\"><?php echo esc_html(tps_pack_text('Skip to content')); ?><\/a>\n\n<?php if (is_front_page()): ?>\n<header class=\"header\"><div class=\"header-main container\"><a aria-label=\"<?php echo esc_attr(tps_pack_text('TPS Pack home')); ?>\" class=\"brand\" href=\"<?php echo esc_url(tps_pack_url()); ?>\"><strong>TPS PACK<\/strong><small>TAPE SOLUTIONS<\/small><\/a><div class=\"header-actions\"><button aria-controls=\"search-panel\" aria-expanded=\"false\" aria-label=\"<?php echo esc_attr(tps_pack_text('Open search')); ?>\" class=\"search-toggle\" id=\"search-toggle\" type=\"button\"><svg aria-hidden=\"true\" fill=\"none\" height=\"24\" stroke=\"currentColor\" stroke-linecap=\"round\
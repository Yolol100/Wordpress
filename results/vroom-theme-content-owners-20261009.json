iv class=\"container faq-grid\"><div><p class=\"eyebrow\"><?php echo esc_html( vroom_editor_value( 'vroom_edit_home_section_faq_eyebrow', 'Veelgestelde vragen' ) ); ?><\/p><?php $faq_title_parts = array_map( 'trim', explode( ' ', vroom_editor_value( 'vroom_edit_home_section_faq_heading', 'Vragen voor je vertrekt?' ) ) ); ?><h2><?php echo esc_html( implode( ' ', array_slice( $faq_title_parts, 0, 2 ) ) ); ?><br><?php echo esc_html( implode( ' ', array_slice( $faq_title_parts, 2 ) ) ); ?><\/h2><p><?php echo esc_html( vroom_editor_value( 'vroom_edit_home_section_faq_intro', 'De belangrijkste antwoorden op een rij.' ) ); ?><\/p><\/div><div>\n\t\t<?php if ( $faqs->have_posts() ) : while ( $faqs->have_posts() ) : $faqs->the_post(); $answer = vroom_field( 'faq_answer', get_the_content() ); ?><details><summary><?php the_title(); ?><span aria-hidden=\"true\">+<\/span><\/summary><div class=\"faq-answer\"><?php echo wp_kses_post( $answer ); ?><\/div><\/details><?php endwhile; wp_reset_postdata(); else : ?>\n\t\t<details><summary><?php esc_html_e( 'Hoe kies ik een lespakket?', 'vroom' ); ?><span aria-hidden=\"true\">+<\/span><\/summary><p><?php esc_html_e( 'Vergelijk het aantal lessen en inbegrepen onderdelen. Tijdens een proefles kun je bespreken wat past bij jouw niveau en planning.', 'vroom' ); ?><\/p><\/details><details><summary><?php esc_html_e( 'Wat zit er bij mijn pakket inbegrepen?', 'vroom' ); ?><span aria-hidden=\"true\">+<\/span><\/summary><p><?php esc_html_e( 'Elk pakket vermeldt de inbegrepen onderdelen. Bespreek de actuele inhoud met Vroom voordat je een pakket afsluit.', 'vroom' ); ?><\/p><\/details><details><summary><?php esc_html_e( 'Kan ik in termijnen betalen?', 'vroom' ); ?><span aria-hidden=\"true\">+<\/span><\/summary><p><?php esc_html_e( 'Bespreek de betaalafspraken en voorwaarden met Vroom voordat je een pakket afsluit.', 'vroom' ); ?><\/p><\/details><details><summary><?php esc_html_e( 'Hoe snel kan ik mijn rijbewijs halen?', 'vroom' ); ?><span aria-hidden=\"true\">+<\/span><\/summary><p><?php esc_html_e( 'Dit hangt af van je niveau, beschikbaarheid en examenplanning. Er wordt geen einddatum gegarandeerd.', 'vroom' ); ?><\/p><\/details><details><summary><?php esc_html_e( 'Kan ik bij mij in de buurt lessen?', 'vroom' ); ?><span aria-hidden=\"true\">+<\/span><\/summary><p><?php esc_html_e( 'Laat je woonplaats weten bij je proeflesaanvraag. De actuele mogelijkheden bespreek je met Vroom.', 'vroom' ); ?><\/p><\/details><?php endif; ?>\n\t<\/div><\/div><\/section>\n\n\t<?php $closing_title = array_map( 'trim', explode( ' ', vroom_editor_value( 'vroom_edit_home_section_closing_heading', 'Jouw vrijheid begint hier' ) ) ); ?>\n\t<section class=\"closing full-bleed\"><img src=\"<?php echo esc_url( get_theme_file_uri( 'assets\/images\/utrecht.webp' ) ); ?>\" alt=\"Vroom-lesauto in Utrecht\" loading=\"lazy\" width=\"1672\" height=\"941\"><div class=\"container\"><p class=\"eyebrow light\"><?php echo esc_html( vroom_editor_value( 'vroom_edit_home_section_closing_eyebrow', 'De weg ligt voor je' ) ); ?><\/p><h2><?php echo esc_html( implode( ' ', array_slice( $closing_title, 0, 2 ) ) ); ?><br><?php echo esc_html( implode( ' ', array_slice( $closing_title, 2 ) ) ); ?><\/h2><a class=\"button button-orange\" href=\"#proefles\"><?php echo esc_html( vroom_editor_value( 'vroom_edit_home_section_closing_button', 'Begin met een proefles' ) ); ?><span class=\"chevron\" aria-hidden=\"true\"><\/span><\/a><\/div><\/section>\n\t<?php vroom_render_editor_extra( 'home' ); ?>\n<\/main>\n<?php get_footer(); ?>\n","fingerprint":"2231b703dd0c1341f66a186801f88216b0d63ac3a1248223878a6c673714e3b0"}},{"action":"filesystem.read_text","result":{"file":{"path":"wp-content\/themes\/vroom-wordpress-theme\/page-rijlessen.php","bytes":12745,"sha256":"6445d479a51a56b195344fd1943e2043aaac7dfc85bcf41c23f4cac817a6b1f1","modified_gmt":"2026-10-09T06:47:12+00:00","writable_text_scope":true},"content":"<?php\n\/*\nTemplate Name: Vroom \u2014 Rijlessen\nTemplate Post Type: page\nDescription: Lesson journey, lesson cars, FAQs and the shared working trial form.\n*\/\nif ( ! defined( 'ABSPATH' ) ) { exit; }\nget_header();\nwhile ( have_posts() ) : the_post();\n$hero_title = vroom_editor_value( 'vroom_edit_heading', 'Rijlessen op jouw tempo' );\n$hero_intro = vroom_editor_value( 'vroom_edit_intro', 'Van je eerste meters tot zelfstandig rijden. Leer met een vaste instructeur, een helder lesplan en ruimte voor jouw tempo.' );\n$tarieven_url = vroom_resolve_page_url( 'tarieven', array( 'lespakketten', 'prijzen' ) );\n$spoed_url = vroom_resolve_page_url( 'spoedcursus', array( 'spoedrijles' ) );\n$theorie_url = vroom_resolve_page_url( 'theorie', array( 'theoriecursus' ) );\n$steps = array(\n array( 'Eerst kennismaken', 'Tijdens de gratis proefles ontmoet je jouw instructeur. Je bespreekt je ervaring, wensen en beschikbaarheid.' ),\n array( 'Een plan dat bij je past', 'Samen bespreek je een passend lesritme en pakket. Je weet waar je aan werkt en welke afspraken daarbij horen.' ),\n array( 'Stap voor stap vooruit', 'Je oefent in verschillende verkeerssituaties. Je instructeur geeft uitleg, feedback en aandacht aan wat jij nodig hebt.' ),\n array( 'Voorbereiden op je examen', 'Je bespreekt wanneer je klaar bent voor het praktijkexamen. Theorie, Gezondheidsverklaring en examenplanning horen daarbij.' ),\n);\n$skills = array(\n array( 'De auto onder controle', 'Optrekken, schakelen, sturen en remmen. Je bouwt een goede basis op.' ),\n array( 'Kijken en vooruitdenken', 'Je leert verkeerssituaties inschatten, op tijd reageren en ruimte houden.' ),\n array( 'Omgaan met verschillende situaties', 'Van kruispunten en rotondes tot invoegen en bijzondere manoeuvres.' ),\n array( 'Zelfstandig keuzes maken', 'Je werkt aan veilige beslissingen en vertrouwen achter het stuur.' ),\n);\n$faqs = array(\n array( 'Vanaf welke leeftijd mag ik rijlessen nemen?', 'Je mag vanaf 16,5 jaar autorijlessen nemen. Vanaf 17 jaar kun je praktijkexamen doen. Slaag je v\u00f3\u00f3r je 18e, dan rijd je tot je 18e met een begeleider en een begeleiderspas.', 'https:\/\/www.rijksoverheid.nl\/vraag-en-antwoord\/rijbewijs\/wanneer-mag-ik-rijles-nemen-en-rijexamen-doen-voor-mijn-autorijbewijs', 'Bekijk de regels bij de Rijksoverheid' ),\n array( 'Moet ik mijn theorie al hebben gehaald?', 'Je kunt met rijlessen beginnen voordat je theorie hebt gehaald. Voor het praktijkexamen heb je een geldig theoriecertificaat nodig. Begin dus op tijd met je voorbereiding.', $theorie_url, 'Bekijk de theoriepagina' ),\n array( 'Hoeveel rijlessen heb ik nodig?', 'Dat verschilt per persoon. Tijdens de proefles bespreek je jouw ervaring en een eerste lesadvies. Je instructeur kijkt tijdens het traject hoe je vooruitgaat; een vooraf bepaald aantal lessen garandeert geen rijbewijs.', '', '' ),\n array( 'Wat zit er in een lespakket?', 'Bekijk per pakket hoeveel lessen en welke examenonderdelen zijn inbegrepen. Bespreek ook de lesduur, eventuele extra kosten en betaalafspraken voordat je een pakket kiest.', $tarieven_url, 'Bekijk pakketten en tarieven' ),\n array( 'Waar kan ik lessen en wanneer kan ik starten?', 'Geef je woonplaats en beschikbare momenten door bij je proeflesaanvraag. We bespreken de mogelijkheden in jouw regio en welk moment bij jou en de instructeur past.', '#proefles', 'Geef je woonplaats door' ),\n array( 'Wat moet ik zelf regelen voor het praktijkexamen?', 'Naast je theoriecertificaat regel je jouw Gezondheidsverklaring bij het CBR. Het CBR beoordeelt daarmee je rijgeschiktheid. Bespreek met je instructeur wat je verder moet regelen en begin op tijd.', 'https:\/\/www.cbr.nl\/nl\/rijden-en-uw-gezondheid\/nl\/gezondheidsverklaring', 'Meer over de Gezondheidsverklaring' ),\n);\n?>\n<main id=\"main\" class=\"lesson-page\">\n <section class=\"lesson-hero\" aria-labelledby=\"lesson-title\">\n  <?php echo vroom_editor_hero_image( 'assets\/images\/den-haag.webp', 'Vroom Volkswagen Golf bij het Vredespaleis in Den Haag', 'lesson-hero-image' ); \/\/ phpcs:ignore WordPress.Security.EscapeOutput.OutputNotEscaped ?>\n  <div class=\"container lesson-hero-content\">\n   <nav class=\"breadcrumbs\" aria-label=\"Kruimelpad\"><a href=\"<?php echo esc_url( home_url( '\/' ) ); ?>\">Home<\/a><span aria-hidden=\"true\">\/<\/span><span aria-current=\"page\"><?php the_title(); ?><\/span><\/nav>\n   <div class=\"lesson-hero-copy\">\n    <p class=\"eyebrow\"><?php echo esc_html( vroom_editor_value( 'vroom_edit_eyebrow', 'Autorijles bij Vroom' ) ); ?><\/p>\n    <h1 id=\"lesson-title\"><?php echo wp_kses( preg_replace( '\/(jouw tempo)\/i', '<span>$1<\/span>', esc_html( $hero_title ) ), array( 'span' => array() ) ); ?><\/h1>\n    <p class=\"lead\"><?php echo esc_html( $hero_intro ); ?><\/p>\n    <div class=\"actions\"><a class=\"button button-orange\" href=\"#proefles\">Plan je gratis proefles<span class=\"chevron\" aria-hidden=\"true\"><\/span><\/a><a class=\"lesson-hero-link\" href=\"#lestraject\">Zo werken de lessen<span class=\"chevron\" aria-hidden=\"true\"><\/span><\/a><\/div>\n    <p class=\"lesson-hero-note\">Vrijblijvend kennismaken \u00b7 Samen jouw lesplan bespreken<\/p>\n   <\/div>\n   <div class=\"lesson-hero-label\"><span aria-hidden=\"true\"><\/span>Jouw rijbewijs, jouw vrijheid<\/div>\n  <\/div>\n <\/section>\n <div class=\"lesson-benefits\"><div class=\"container lesson-benefits-grid\">\n  <?php $benefits = array( array( 'person', 'Vaste instructeur', 'Een vertrouwd aanspreekpunt' ), array( 'calendar', 'Jouw lesritme', 'Planning in overleg' ), array( 'route', 'Duidelijk lesadvies', 'Begin met een proefles' ), array( 'pin', 'In jouw regio', 'Geef je woonplaats door' ) ); foreach ( $benefits as $benefit ) : ?>\n  <div class=\"lesson-benefit\"><?php vroom_lesson_icon( $benefit[0] ); ?><div><strong><?php echo esc_html( $benefit[1] ); ?><\/strong><p><?php echo esc_html( $benefit[2] ); ?><\/p><\/div><\/div>\n  <?php endforeach; ?>\n <\/div><\/div>\n <?php if ( vroom_editor_blocks_ready( 'rijlessen' ) ) : ?>\n <?php vroom_render_editor_blocks( 'rijlessen', 'lestraject' ); ?>\n <?php else : ?>\n <section class=\"lesson-section\" id=\"lestraject\" aria-labelledby=\"lesson-process-title\"><div class=\"container lesson-process\">\n  <div class=\"lesson-section-copy\"><p class=\"eyebrow\">Van proefles tot praktijkexamen<\/p><h2 id=\"lesson-process-title\"><?php echo esc_html( vroom_field( 'vroom_lessons_process_title', 'Jouw route naar het rijbewijs' ) ); ?><\/h2><p><?php echo esc_html( vroom_field( 'vroom_lessons_process_intro', 'Je hoeft nog niet te weten hoeveel lessen je nodig hebt. We beginnen bij jouw ervaring en bouwen daarop verder. Met een plan dat overzicht geeft en ruimte laat om te leren.' ) ); ?><\/p><a class=\"text-link\" href=\"<?php echo esc_url( $tarieven_url ); ?>\">Bekijk de lespakketten<span class=\"chevron\" aria-hidden=\"true\"><\/span><\/a><\/div>\n  <ol class=\"lesson-timeline\"><?php foreach ( $steps as $index => $step ) : $n = $index + 1; ?><li><span class=\"lesson-step-number\" aria-hidden=\"true\"><?php echo esc_html( sprintf( '%02d', $n ) ); ?><\/span><div><h3><?php echo esc_html( vroom_field( \"vroom_lessons_step_{$n}_title\", $step[0] ) ); ?><\/h3><p><?php echo esc_html( vroom_field( \"vroom_lessons_step_{$n}_text\", $step[1] ) ); ?><\/p><\/div><\/li><?php endforeach; ?><\/ol>\n <\/div><\/section>\n <section class=\"lesson-section lesson-skills-section\" aria-labelledby=\"lesson-skills-title\"><div class=\"container lesson-skills\">\n  <figure class=\"lesson-editorial-photo\"><img src=\"<?php echo esc_url( get_theme_file_uri( 'assets\/images\/amsterdam.webp' ) ); ?>\" alt=\"Witte Vroom BMW 1 Serie bij de Magere Brug in Amsterdam\" loading=\"lazy\" width=\"1672\" height=\"941\"><figcaption><span>Jouw volgende stap<\/span><strong>Vertrouwen achter het stuur<\/strong><\/figcaption><\/figure>\n  <div class=\"lesson-section-copy\"><p class=\"eyebrow\">Leren voor de weg<\/p><h2 id=\"lesson-skills-title\"><?php echo esc_html( vroom_field( 'vroom_lessons_skills_title', 'Je leert meer dan sturen' ) ); ?><\/h2><p><?php echo esc_html( vroom_field( 'vroom_lessons_skills_intro', 'Een rijbewijs begint bij begrijpen wat je doet. Je oefent de techniek \u00e9n leert vooruitdenken, zodat je steeds zelfstandiger rijdt.' ) ); ?><\/p><ul class=\"lesson-skill-list\"><?php foreach ( $skills as $index => $skill ) : $n = $index + 1; ?><li><span aria-hidden=\"true\">\u2713<\/span><div><h3><?php echo esc_html( vroom_field( \"vroom_lessons_skill_{$n}_title\", $skill[0] ) ); ?><\/h3><p><?php echo esc_html( vroom_field( \"vroom_lessons_skill_{$n}_text\", $skill[1] ) ); ?><\/p><\/div><\/li><?php endforeach; ?><\/ul><\/div>\n <\/div><\/section>\n <?php endif; ?>\n <section class=\"lesson-section\" aria-labelledby=\"lesson-package-title\"><div class=\"container lesson-package-layout\">\n  <div class=\"lesson-section-copy\"><p class=\"eyebrow\">Jouw startpunt, jouw lesplan<\/p><h2 id=\"lesson-package-title\"><?php echo esc_html( vroom_field( 'vroom_lessons_package_title', 'Een lespakket begint bij jou' ) ); ?><\/h2><p><?php echo esc_html( vroom_field( 'vroom_lessons_package_intro', 'Wat je al kunt, hoe je leert en wanneer je kunt lessen: dat bepaalt wat bij je past. Bespreek je lesadvies tijdens de proefles en vergelijk daarna rustig de pakketten.' ) ); ?><\/p><a class=\"button button-orange\" href=\"#proefles\">Ontdek wat bij je past<span class=\"chevron\" aria-hidden=\"true\"><\/span><\/a><\/div>\n  <div class=\"lesson-options\">\n   <a class=\"lesson-option\" href=\"<?php echo esc_url( $tarieven_url ); ?>\"><div><span>Lespakketten<\/span><h3>Helder over lessen en kosten<\/h3><p>Vergelijk het aantal lessen, de inbegrepen onderdelen en de betaalafspraken.<\/p><b>Bekijk de tarieven<\/b><\/div><span class=\"lesson-option-arrow\" aria-hidden=\"true\"><span class=\"chevron\"><\/span><\/span><\/a>\n   <a class=\"lesson-option\" href=\"<?php echo esc_url( $spoed_url ); ?>\"><div><span>Meer lessen per week<\/span><h3>Liever een intensiever traject?<\/h3><p>Bespreek de mogelijkheden voor een spoedcursus. Planning en beschikbaarheid bepalen het tempo.<\/p><b>Bekijk de spoedcursus<\/b><\/div><span class=\"lesson-option-arrow\" aria-hidden=\"true\"><span class=\"chevron\"><\/span><\/span><\/a>\n  <\/div>\n <\/div><\/section>\n <section class=\"lesson-section lesson-fleet-section\" aria-labelledby=\"lesson-fleet-title\"><div class=\"container\"><div class=\"section-heading\"><div><p class=\"eyebrow\">Vertrouwd achter het stuur<\/p><h2 id=\"lesson-fleet-title\"><?php echo esc_html( vroom_field( 'vroom_lessons_fleet_title', 'Maak kennis met onze lesauto\u2019s' ) ); ?><\/h2><\/div><p><?php echo esc_html( vroom_field( 'vroom_lessons_fleet_intro', 'De lesauto hoort bij jouw instructeur. Bespreek welke auto en lesmogelijkheden beschikbaar zijn in jouw regio.' ) ); ?><\/p><\/div><?php get_template_part( 'template-parts\/fleet-grid', null, array( 'grid_class' => 'fleet-grid lesson-fleet-grid' ) ); ?><\/div><\/section>\n <?php get_template_part( 'template-parts\/learner-reviews' ); ?>\n <section class=\"lesson-section lesson-faq\" id=\"vragen\" aria-labelledby=\"lesson-faq-title\"><div class=\"container faq-grid\"><div><p class=\"eyebrow\">Goed om te weten<\/p><h2 id=\"lesson-faq-title\">Vragen voor je eerste les?<\/h2><p>De belangrijkste antwoorden voordat je begint.<\/p><a class=\"text-link\" href=\"<?php echo esc_url( vroom_resolve_page_url( 'contact' ) ); ?>\">Stel ons je vraag<span class=\"chevron\" aria-hidden=\"true\"><\/span><\/a><\/div><div><?php foreach ( $faqs as $index => $faq ) : $n = $index + 1; ?><details><summary><?php echo esc_html( vroom_field( \"vroom_lessons_faq_{$n}_question\", $faq[0] ) ); ?><\/summary><div class=\"lesson-faq-answer\"><p><?php echo esc_html( vroom_field( \"vroom_lessons_faq_{$n}_answer\", $faq[1] ) ); ?><\/p><?php if ( $faq[2] ) : ?><a class=\"text-link\" href=\"<?php echo esc_url( $faq[2] ); ?>\"><?php echo esc_html( $faq[3] ); ?><span class=\"chevron\" aria-hidden=\"true\"><\/span><\/a><?php endif; ?><\/div><\/details><?php endforeach; ?><\/div><\/div><\/section>\n <section class=\"lesson-section lesson-booking\" aria-labelledby=\"lesson-booking-title\"><div class=\"container lesson-booking-grid\"><div class=\"lesson-section-copy\"><p class=\"eyebrow\">Jouw eerste rit<\/p><h2 id=\"lesson-booking-title\"><?php echo esc_html( vroom_field( 'vroom_lessons_booking_title', 'Voel of Vroom bij je past' ) ); ?><\/h2><p><?php echo esc_html( vroom_field( 'vroom_lessons_booking_intro', 'Maak kennis met de instructeur, ervaar de lesauto en bespreek jouw wensen. Laat je gegevens achter; we nemen contact met je op om een moment af te spreken.' ) ); ?><\/p><ul class=\"lesson-booking-checks\"><li><span aria-hidden=\"true\">\u2713<\/span>Gratis en vrijblijvend kennismaken<\/li><li><span aria-hidden=\"true\">\u2713<\/span>Bespreek jouw ervaring en lesadvies<\/li><li><span aria-hidden=\"true\">\u2713<\/span>Samen een passend lesmoment kiezen<\/li><\/ul><\/div><?php get_template_part( 'template-parts\/trial-form', null, array( 'settings_id' => absint( get_option( 'page_on_front' ) ) ) ); ?><\/div><\/section>\n<\/main>\n<?php endwhile; get_footer(); ?>\n","fingerprint":"7f881104ccfea4328e702e258b541b95a3259622016bf90b57a1c77a9a940e95"}},{"action":"filesystem.read_text","result":{"file":{"path":"wp-content\/themes\/vroom-wordpress-theme\/page.php","bytes":486,"sha256":"db26ad4e19049fd68be7342e44f27cc8686974ee3e362de2e49eed74ff86ff39","modified_gmt":"2026-10-09T06:47:12+00:00","writable_text_scope":true},"content":"<?php\n\/** Standard WordPress page template (also used for legal pages). *\/\nget_header();\n?>\n<main id=\"main\" class=\"legal-main\">\n\t<div class=\"container\">\n\t\t<?php while ( have_posts() ) : the_post(); ?>\n\t\t\t<article <?php post_class( 'legal-page-content' ); ?>><h1><?php the_title(); ?><\/h1><?php if ( has_post_thumbnail() ) { the_post_thumbnail( 'large' ); } ?><div class=\"entry-content\"><?php the_content(); ?><\/div><\/article>\n\t\t<?php endwhile; ?>\n\t<\/div>\n<\/main>\n<?php get_footer(); ?>\n","fingerprint":"47770e12ffaa5abf3f6b0f6eda75d60610198d524779460748764ff418116b1b"}},{"action":"filesystem.read_text","result":{"file":{"path":"wp-content\/themes\/vroom-wordpress-theme\/README.md","bytes":8172,"sha256":"65f9f0f45a048bd472d64da37dedcf7be3f33ad004ef8ac8a7d497092580bc9e","modified_gmt":"2026-10-09T06:47:12+00:00","writable_text_scope":true},"content":"Vroom 2.6.0 \u2014 Gutenberg, ACF-tekstmigratie en uitlijning\n\n- Nieuwe ACF editorpanelen voor de homepage-intro en shared heroes.\n- ACF is optioneel; zonder ingevulde velden blijft de bestaande opmaak intact.\n- Spoedcursus, Theorie, Rijlessen, Over Vroom, Werken met Vroom en Help: Gutenberg-tekstsecties opt-in via ACF; eerst volledige Core-blokken migreren, controleren en pas daarna de schakelaar activeren.\n- Tien Gutenberg-patronen: vijf basispatronen, de bestaande cursuspagina-indelingen en de nieuwe per-pagina-indelingen en extra informatiesectie.\n- Bestaande formulieren, prijscalculator, reviews, FAQ's en templates blijven actief.\n- Homepage, Tarieven, FAQ, Contact en Proefles krijgen aanvullende ACF-velden voor vaste koppen, intro's en USP's, plus optionele Gutenberg-informatiesecties.\n- Geen automatische database- of paginainhoudmigratie bij een thema-update.\n- Test op staging met ACF actief en uitgeschakeld, echte Gutenberg-editor en beide formulieren.\n\n# Thema-architectuur\n\nKlassiek WordPress-thema met vaste PHP-paginatemplates, `inc\/` voor applicatielogica, `template-parts\/` voor gedeelde secties, en `assets\/` voor lokale stijlen, scripts en afbeeldingen. `theme.json` regelt de editor-basistokens. Dit is geen block theme.\n\n## Ingebruikname\n\n1. Maak een volledige backup van de WordPress-database en bestanden.\n2. Installeer de ZIP op staging via Weergave > Thema's > Thema toevoegen.\n3. Controleer alle pagina's, hoofd-\/footermenu, bestaande URL's, SEO-output, editor, formulieren en e-mailbezorging.\n4. Verifieer actieve SEO-, cache-, privacy-, beveiligings- en eventuele WooCommerce-plugins voordat je publiceert.\n\n## Belangrijke afspraken\n\n- Bij eerste activatie worden ontbrekende pagina's gemaakt. Bestaande niet-lege pagina-inhoud en de permalinkstructuur blijven bewaard. De installatie stelt zo nodig pagina-templates, startpagina en menu's in.\n- Het thema werkt zonder Elementor of ACF. Met ACF Free of PRO zijn extra teksten en Gutenberg-tekstsecties veilig te beheren. Formulieren, calculatie, dynamische reviews en sommige vaste secties blijven in PHP.\n- Formulieren sturen met `wp_mail()`; bezorging is pas bevestigd na een echte stagingtest.\n- Met Yoast, Rank Math, SEOPress of AIOSEO laat het thema de SEO-titel en metabeschrijving aan de plugin over.\n- Het voorbeeldtelefoonnummer **123456789**, het e-mailadres **info@vroomrijscholen.nl**, de voorbeeldlocatie, alle prijzen\/kortingen en fictieve reviews moeten v\u00f3\u00f3r livegang door de eigenaar worden bevestigd.\n- Er staan AI-gegenereerde sfeerbeelden in het pakket; dit zijn geen geverifieerde foto's van de werkelijke vloot.\n- De vijf lokale Manrope-fonts gebruiken WOFF2; de SIL OFL-licentie staat bij `assets\/fonts\/OFL.txt`.\n- Bedankpagina's zijn noindex bedoeld. Het thema maakt geen claim van volledige WCAG-, AVG-, SEO- of WordPress.org-conformiteit.\n\n## Release 2.3.5\n\n- De mobiele proeflesknop is vergroot voor betere leesbaarheid en bediening.\n- Binnenpagina's met een gestapelde hero tonen op mobiel en kleine tablets de afbeelding v\u00f3\u00f3r breadcrumb, minititel, titel en inleiding.\n- H1-formaten zijn in een gedeelde typografische schaal afgestemd op mobiel, tablet en desktop.\n- Het gecentreerde logo in de WordPress-thema-preview is subtiel kleiner gemaakt.\n- 2.3.4 is de enige codebasis voor deze update. Overbodige\/herhaalde CSS-declaraties zijn verwijderd; oude themabestanden of distributieversies zijn niet opgenomen.\n- Fictieve reviews, voorbeeldgegevens en commerci\u00eble\/juridische teksten blijven expliciet ter controle voor livegang.\n\n**Status: STAGING-FIRST.** Een echte WordPress-, plugin-, device-, formulieren- en e-mailtest blijft verplicht v\u00f3\u00f3r publicatie.\n\n\n## 2.4.1 - Gutenberg pilot inhoud\n\n- Twee nieuwe kant-en-klare, bewerkbare Gutenberg-patronen: `Vroom - Spoedcursus - complete tekst` en `Vroom - Theorie - complete tekst`.\n- Gewone tekst, kaarten, afbeelding en links zijn native Core-blokken. De originele tekst is behouden.\n- Cursusprijzen\/keuzes (Theorie), FAQ (Spoedcursus) en formulieren blijven buiten de Gutenberg-inhoud in de bestaande PHP-componenten.\n- Het opslaan\/installeren van dit thema wijzigt geen bestaande WordPress-`post_content` en zet de ACF-schakelaar niet automatisch aan.\n- Voor migratie van de bestaande pagina-inhoud op **staging** is een apart WP-CLI-pakket beschikbaar. Eerst back-up, daarna per pagina importeren, in Gutenberg controleren en pas daarna de ACF-schakelaar aanzetten.\n- Het WP-CLI-pakket hoort niet in de publieke WordPress-thema-ZIP.\n\n## 2.4.2 - migratiebeveiliging\n\n- Bestaande menu-items worden niet opnieuw gesorteerd vanuit wp-admin. Alleen een nieuwe installatie krijgt de standaardvolgorde; Gratis proefles staat uitsluitend als headerknop.\n- Gutenberg wordt uitsluitend getoond als beide Vroom-secties compleet zijn; anders blijft de eerdere PHP-weergave actief.\n- Het externe stagingmigratiepakket weigert import wanneer ACF niet actief is of de Gutenberg-schakelaar aan staat. Herstel zet die schakelaar uit voor het terugschrijven.\n- De migratie-CLI is een apart pakket en hoort niet thuis in de publieke theme-ZIP.\n\n\n## Release 2.5.0 \u2014 Editor, ACF en kleinere hoeken\n\n- Per pagina: vier nieuwe volledige Gutenberg-patronen voor Rijlessen, Over Vroom, Werken met Vroom en Help.\n- Spoedcursus\/Theorie behouden hun bestaande Gutenberg-patronen. Alle zes pagina's vervangen hun PHP-tekstsecties pas wanneer ACF de veilige, complete Gutenberg-inhoud inschakelt.\n- Herbruikbare extra tekstsectie voor Home, Tarieven, Reviews, Contact, Gratis proefles en FAQ. Bij standaardinstellingen verandert niets op de website.\n- Over Vroom houdt de bestaande autosectie; Werken met Vroom het samenwerkingsformulier; Help de FAQ; Rijlessen houdt lesauto's, reviews, FAQ en proeflesformulier.\n- ACF velden voor hero's, homepage USPs en tekstsecties, contact-, tarieven-, FAQ- en aanvraagkoppen; ACF is optioneel en geen pagebuilder.\n- Formulieren, links, navigatie, CTA's, calculaties, prijzen, reviews en SEO worden niet gemigreerd.\n- Ronde hoeken bij kaarten, foto's, knoppen en formulierpanelen gematigd verkleind; echte cirkels blijven rond. Geldt ook voor editorstijlen.\n- Staging-only migratie- en herstel-CLI worden **apart** meegeleverd, niet in de thema-ZIP. Vereist back-up, editorcontrole en ACF-schakelaar eerst UIT.\n- Een installatie\/upgrade verandert nooit automatisch de bestaande Gutenberg-tekst, pagina-inhoud of ACF-schakelaars.\n\nDe tests van deze ZIP zijn lokaal; een echte WordPress-installatie, de ge\u00efframeerde Gutenberg-editor, e-mailbezorging en actieve plugincombinaties moeten nog op staging worden gecontroleerd.\n\n\n## Release 2.6.0 \u2014 ACF-tekstmigratie en UI\n\n- Alle vastgelegde redactionele paginateksten uit `inc\/copy-defaults.php` zijn als bewerkbare ACF Free-velden per paginatype geregistreerd, onder duidelijke tabbladen. De standaardweergave blijft gelijk totdat een veld wordt gewijzigd.\n- Via **Vroom \u2192 Paginagegevens overzetten naar ACF \u2192 Standaardteksten importeren** kan een beheerder na databaseback-up de bronwaarden eenmalig in lege ACF-velden plaatsen. Er is geen automatische databasewrite bij thema-activatie of thema-update.\n- De import overschrijft geen bestaande ACF-waarden; herhalen is veilig. **Ongwijzigde import terugdraaien** verwijdert alleen waarden die niet door de redacteur zijn veranderd.\n- Bestaande Gutenberg-secties blijven afhankelijk van de aparte ACF-schakelaar en voltooide Gutenberg-pagina-inhoud. Een ACF-tekstveld dat bij ingeschakelde Gutenberg-stand hoort, past de blokkentekst niet automatisch aan.\n- De proeflesformulieren hebben geen optioneel berichtveld meer. Het gewone contactformulier houdt zijn eigen berichtveld. De knop op Tarieven springt naar de pakketvergelijking.\n- **Desktop vanaf 1201px:** het volledige derde voordeel \u2018Betaal in termijnen\u2019 in de bovenste lichtblauwe balk staat **12px verder rechts**. Icoon en tekst bewegen samen; de tweede balk en kleinere schermen blijven ongemoeid.\n- Maak de nieuwe ZIP eerst actief op staging en test de Gutenberg-editor, ACF-metaboxen, import\/terugdraaien, formulieren, SEO\/caching en toegankelijkheid. Deze codecontrole vervangt geen echte WordPress-acceptatie.\n","fingerprint":"57ed5f27a819ccab1205753480c16b5c5820c68dab3650b91042b1e63f230585"}}]},"meta":{"request_fingerprint":"4d5e2e7e52165ba333b0c25749aea6207f8a6fd98fb3c010e1a17d1f5ec9e3f7"}}
{"version":1,"ok":true,"request_id":"vroom-theme-content-owners-20261009","action":"connector.read_batch","dry_run":true,"completed_at_gmt":"2026-10-09T09:12:07+00:00","data":{"operations":[{"action":"filesystem.read_text","result":{"file":{"path":"wp-content\/themes\/vroom-wordpress-theme\/front-page.php","bytes":14401,"sha256":"00838bdcd6bedf7722236e16c0c8862cd79976e19af5db485c5d02a908107f47","modified_gmt":"2026-10-09T06:47:12+00:00","writable_text_scope":true},"content":"<?php\n\/**\n * Template Name: Vroom \u2014 Home\n * Template Post Type: page\n * Homepage template for Vroom.\n *\/\nif ( ! defined( 'ABSPATH' ) ) { exit; }\nget_header();\n$fallback_cities = array(\n\tarray( 'Den Haag', 'Volkswagen Golf', 'assets\/images\/den-haag.webp', 'Volkswagen Golf bij het Vredespaleis in Den Haag' ),\n\tarray( 'Rotterdam', 'Mercedes-Benz A-Klasse', 'assets\/images\/rotterdam.webp', 'Mercedes-Benz A-Klasse bij de Erasmusbrug in Rotterdam' ),\n\tarray( 'Amsterdam', 'BMW 1 Serie', 'assets\/images\/amsterdam.webp', 'BMW 1 Serie bij de Magere Brug in Amsterdam' ),\n\tarray( 'Utrecht', 'Audi A3', 'assets\/images\/utrecht.webp', 'Audi A3 bij de Domtoren in Utrecht' ),\n);\n$fallback_cards = array(\n\tarray( 'Rijlessen', 'assets\/images\/den-haag.webp', vroom_resolve_page_url( 'rijlessen', array( 'rijles', 'autorijles' ) ) ),\n\tarray( 'Spoedcursus', 'assets\/images\/rotterdam.webp', vroom_resolve_page_url( 'spoedcursus', array( 'spoedrijles' ) ) ),\n\tarray( 'Theorie', 'assets\/images\/amsterdam.webp', vroom_resolve_page_url( 'theorie', array( 'theoriecursus' ) ) ),\n\tarray( 'Lespakketten', 'assets\/images\/utrecht.webp', vroom_resolve_page_url( 'tarieven', array( 'lespakketten', 'prijzen' ) ) ),\n);\n$benefits = array(\n\tarray( 'Een vaste instructeur', 'Je leert van iemand die jouw voortgang kent.' ),\n\tarray( 'Lessen in jouw tempo', 'Plan lessen die passen bij jouw agenda.' ),\n\tarray( '\u20ac 5 korting per les', 'Vraag naar de actuele actievoorwaarden.' ),\n\tarray( 'In
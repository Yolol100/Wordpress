ue},{"name":"tape-converting-workstation.webp","path":"wp-content\/themes\/tps-pack-wordpress-theme\/assets\/tape-converting-workstation.webp","type":"file","bytes":93554,"modified_gmt":"2026-10-12T09:07:08+00:00","writable_text_scope":false}],"truncated":false,"max_entries":200}},{"action":"filesystem.read_text","result":{"file":{"path":"wp-content\/themes\/tps-pack-wordpress-theme\/inc\/page-setup.php","bytes":2587,"sha256":"21ab066852fa8cb168ea9ff9e0c96e49ed6f29fe55063555f86baef7aac1e2cf","modified_gmt":"2026-10-12T09:07:08+00:00","writable_text_scope":true},"content":"<?php\n\/** Idempotent, admin-only page provisioning and safe English ACF field seeding. *\/\nif (!defined('ABSPATH')) exit;\n\nfunction tps_pack_seed_page_fields($slug, $page_id) {\n foreach (tps_pack_editor_specs($slug) as $spec) {\n  $name = $spec['name'];\n  $existing = get_post_meta($page_id, $name, true);\n  \/\/ Never replace an editor's non-empty value or an intentional non-string value.\n  if (!is_string($existing) || $existing !== '') {\n   if (!metadata_exists('post',$page_id,'_' . $name)) {\n    update_post_meta($page_id, '_' . $name, $spec['key']);\n   }\n   continue;\n  }\n  if (!update_post_meta($page_id, $name, $spec['default'])) {\n   \/\/ An unchanged pre-existing value is not an error.\n   if (get_post_meta($page_id,$name,true) !== $spec['default']) return false;\n  }\n  if (!metadata_exists('post',$page_id,'_' . $name)) {\n   update_post_meta($page_id, '_' . $name, $spec['key']);\n  }\n }\n return true;\n}\n\nfunction tps_pack_provision_english_pages() {\n if (!is_admin() || !current_user_can('manage_options')) return;\n if (get_option('tps_pack_english_content_version') === '2.3.0') return;\n $success = true;\n $pages = tps_pack_page_slugs();\n foreach ($pages as $slug) {\n  $existing = get_page_by_path($slug, OBJECT, 'page');\n  if ($existing) {\n   $id = (int) $existing->ID;\n  } else {\n   $id = wp_insert_post(array(\n    'post_type'=>'page', 'post_status'=>'publish',\n    'post_name'=>$slug,'post_title'=>tps_pack_english_page_title($slug, ucwords(str_replace('-', ' ', $slug))),\n    'post_content'=>''\n   ), true);\n   if (is_wp_error($id) || !$id) { $success=false; continue; }\n  }\n  if (!tps_pack_seed_page_fields($slug, (int) $id)) $success=false;\n }\n \/\/ Provision a homepage only if the site does not already use an assigned one.\n $front_id = (int) get_option('page_on_front');\n if (get_option('show_on_front') !== 'page' || !$front_id || get_post_type($front_id) !== 'page') {\n  $home = get_page_by_path('home', OBJECT, 'page');\n  if (!$home) {\n   $front_id = wp_insert_post(array('post_type'=>'page','post_status'=>'publish',\n    'post_name'=>'home','post_title'=>'Home','post_content'=>''),true);\n   if (is_wp_error($front_id) || !$front_id) { $success=false; $front_id=0; }\n  } else $front_id = (int) $home->ID;\n }\n if ($front_id && !tps_pack_seed_page_fields('home', (int) $front_id)) $success=false;\n if ($success) {\n  update_option('tps_pack_english_content_version','2.3.0', false);\n  \/\/ This idempotent release refresh leaves previously editor-entered content untouched.\n  flush_rewrite_rules(false);\n }\n}\nadd_action('admin_init','tps_pack_provision_english_pages',40);\n","fingerprint":"48d14321dd0586facbc0dc877567b196b7f0439288d200d5d74e48f914c824a9"}},{"action":"filesystem.read_text","result":{"file":{"path":"wp-content\/themes\/tps-pack-wordpress-theme\/footer.php","bytes":2437,"sha256":"de556bef869337492ea9a9f9fa600d26490d775dff4840a0b20bc9eff2edef25","modified_gmt":"2026-10-12T12:33:36+00:00","writable_text_scope":true},"content":"<?php if (!defined('ABSPATH')) exit; ?>\n<footer class=\"footer\">\n  <div class=\"container footer-grid footer-grid-calm\">\n    <div class=\"footer-summary-col\">\n      <a class=\"brand\" href=\"<?php echo esc_url(tps_pack_url()); ?>\"><strong>TPS PACK<\/strong><small>TAPE SOLUTIONS<\/small><\/a>\n      <p class=\"footer-summary\"><?php echo esc_html(tps_pack_text('16 years of tradi